{
  "name": "phone-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "捡手机模拟器 —— 创作端 + 作品端",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:creator": "pnpm --filter @phone-sim/creator dev",
    "dev:player": "pnpm --filter @phone-sim/player dev",
    "build": "pnpm build:player && pnpm build:creator",
    "build:player": "pnpm --filter @phone-sim/player build",
    "build:creator": "pnpm --filter @phone-sim/creator build",
    "preview:player": "pnpm --filter @phone-sim/player preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "node scripts/check-lint.mjs",
    "lint:fix": "node scripts/check-lint.mjs --fix",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:bundle": "node scripts/check-player-bundle.mjs",
    "check:layout": "node scripts/probe-shell-layout.mjs",
    "check:creator": "node scripts/probe-creator-flow.mjs",
    "check:x-search": "node scripts/probe-x-search.mjs",
    "check:lifecycle": "node scripts/probe-lifecycle.mjs",
    "check:manual": "node scripts/probe-creator-manual.mjs",
    "check:preview": "node scripts/probe-preview-bridge.mjs",
    "check:system": "node scripts/probe-system.mjs",
    "shot:shell": "node scripts/shot-shell.mjs",
    "verify:file": "node scripts/verify-file-open.mjs",
    "check:export": "node scripts/probe-export-package.mjs",
    "check:export:ui": "node scripts/probe-export-ui.mjs",
    "check:photos": "node scripts/probe-photos-editor.mjs",
    "shot:photos-editor": "node scripts/shot-photos-editor.mjs",
    "shot:kt-voice": "node scripts/shot-kt-voice.mjs",
    "shot:media-align": "node scripts/shot-media-align.mjs",
    "check": "pnpm lint && pnpm check:boundaries && pnpm test && pnpm build:player && pnpm check:bundle && pnpm check:layout && pnpm verify:file && pnpm check:preview && pnpm check:system && pnpm check:export && pnpm check:export:ui && pnpm check:photos"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^9.15.0",
    "eslint-plugin-vue": "^9.32.0",
    "fake-indexeddb": "^6.2.6",
    "fflate": "^0.8.3",
    "globals": "^15.12.0",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vue-eslint-parser": "^9.4.3"
  }
}
